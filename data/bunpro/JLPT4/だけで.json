      "attributes": {
        "id": 181,
        "relationship_type": "related",
        "body": "だけ conveys the meaning of 'only' or 'just.' だけで is the combination of だけ with the particle で, conveying the idea of the manner or means by which something is done. だけで expresses 'just by' or 'merely with' (literally, 'with/using only A'). It typically follows either nouns or verbs, suggesting that the thing or action was the only thing needed to achieve a certain result.",
        "first_relatable": {
          "id": 43,
          "slug": "だけ",
          "title": "だけ",
          "meaning": "Only, Just",
