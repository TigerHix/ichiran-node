    {
      "id": "1148",
      "type": "related_content",
      "attributes": {
        "id": 1148,
        "relationship_type": "misc",
        "body": "だけあって and だけで may look similar, but they have distinct meanings. だけあって is used when a result is seen as natural or expected, similar to 'as you'd expect from (A)'. This is close in nuance to a separate expression, だけに. In contrast, だけで expresses that something is 'enough' to accomplish something else, like 'just by (A)' or 'only with (A)' in English.",
        "first_relatable": {
          "id": 335,
