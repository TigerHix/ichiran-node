    {
      "id": "9",
      "type": "related_content",
      "attributes": {
        "id": 9,
        "relationship_type": "related",
        "body": "Both あとで and たら can show that one action follows another, but their usage and nuance differ. あとで simply shows sequence, like 'after doing (A)'. たら adds a conditional nuance and can mean 'when' (temporal) or 'if' (hypothetical). Because of this, they are rarely interchangeable.",
        "first_relatable": {
          "id": 116,
          "slug": "あとで",
          "title": "あとで",
          "meaning": "After, Later",
