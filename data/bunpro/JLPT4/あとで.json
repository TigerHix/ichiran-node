      "type": "related_content",
      "attributes": {
        "id": 819,
        "relationship_type": "related",
        "body": "Both 上で and あとで express that one action follows another, but with different nuances. あとで simply shows sequence, like 'after doing (A)'. 上で implies the first action is a necessary step for the second, similar to 'upon doing (A)', and is more formal, often used in writing or business contexts.",
        "first_relatable": {
          "id": 198,
          "slug": "上で",
          "title": "上で",
          "meaning": "After, Upon",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
