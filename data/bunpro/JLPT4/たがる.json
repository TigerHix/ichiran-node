    {
      "id": "542",
      "type": "related_content",
      "attributes": {
        "id": 542,
        "relationship_type": "related",
        "body": "がる attaches to adjectives to describe the observed feelings or desires of another person, e.g. 寒がる 'seems cold', ほしがる 'seems to want (A)', and so on. When combined with the たい-form of verbs, it becomes たがる, expressing observed desire, e.g. 飲みたがる 'seems to want to drink'.",
        "first_relatable": {
          "id": 112,
          "slug": "がる",
          "title": "がる",
          "meaning": "To feel, To think, To act as if, To want, To desire",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 124,
          "slug": "たがる",
          "title": "たがる",
          "meaning": "To want to (Third person)",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "398",
      "type": "related_content",
      "attributes": {
        "id": 398,
        "relationship_type": "related",
        "body": "がほしい and たがる both express desire but differ in usage. がほしい is used for the speaker's own wants, e.g. 車がほしい ('I want a car.'). たがる combines the たい-form of verbs with がる to describe a third person's apparent desire to do something, e.g. 田中さんは車を買いたがっている ('Tanaka seems to want to buy a car.').",
        "first_relatable": {
          "id": 91,
          "slug": "がほしい",
          "title": "がほしい",
          "meaning": "To want something, To be in need of",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 124,
          "slug": "たがる",
          "title": "たがる",
          "meaning": "To want to (Third person)",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "418",
      "type": "related_content",
      "attributes": {
        "id": 418,
        "relationship_type": "related",
        "body": "てほしい and たがる both express desire but in different ways. てほしい is used when the speaker wants someone else to do something, e.g. これを買ってほしい ('I want you to buy this.'). たがる combines the たい-form with がる to describe a third person's apparent desire, e.g. 田中さんは車を買いたがっている ('Tanaka seems to want to buy a car.').",
        "first_relatable": {
          "id": 101,
          "slug": "てほしい",
          "title": "てほしい",
          "meaning": "I want you to",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 124,
          "slug": "たがる",
          "title": "たがる",
          "meaning": "To want to (Third person)",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
