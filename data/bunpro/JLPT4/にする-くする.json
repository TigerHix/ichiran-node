    {
      "id": "1389",
      "type": "related_content",
      "attributes": {
        "id": 1389,
        "relationship_type": "related",
        "body": "～にする・～くする and ～になる・～くなる express change but differ in focus. ～にする and ～くする imply making something a certain way, e.g. 綺麗にする 'make clean', 甘くする 'make sweet'. ～になる and ～くなる describe something changing on its own, e.g. 綺麗になる 'become clean', 甘くなる 'become sweet'. The difference is between focusing on the agent causing the change, or simply framing it in terms of the thing itself changing.",
        "first_relatable": {
          "id": 728,
          "slug": "にする-くする",
          "title": "～にする・～くする",
          "meaning": "Adjective + する, To make something/someone (more)",
