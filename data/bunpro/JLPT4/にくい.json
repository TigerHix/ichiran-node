    {
      "id": "998",
      "type": "related_content",
      "attributes": {
        "id": 998,
        "relationship_type": "related",
        "body": "がたい and にくい both attach to verb stems and express the idea of 'difficult to do', but with different nuance and formality levels. にくい is used in everyday speech and reflects the speaker's personal sense of difficulty or discomfort. がたい is more formal/written-style and implies something is nearly impossible or extremely difficult due to factors beyond the speaker's control.",
        "first_relatable": {
          "id": 257,
          "slug": "がたい",
          "title": "がたい",
          "meaning": "Hard to, Difficult to",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 100,
          "slug": "にくい",
          "title": "にくい",
          "meaning": "Difficult to, Hard to",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "396",
      "type": "related_content",
      "attributes": {
        "id": 396,
        "relationship_type": "antonym",
        "body": "やすい and にくい express opposite ideas: 'easy to do' and 'hard to do.' Both attach to verb stems, e.g. 食べやすい 'easy to eat' and 食べにくい 'hard to eat', and function as い-adjectives, meaning they can be seen with tenses like 食べやすかった 'was easy to eat', and modify nouns like with 食べやすい果物 'an easy-to-eat fruit'.",
        "first_relatable": {
          "id": 90,
          "slug": "やすい",
          "title": "やすい",
          "meaning": "Easy to, Likely to",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 100,
          "slug": "にくい",
          "title": "にくい",
          "meaning": "Difficult to, Hard to",
          "level": "JLPT4",
