          "ほかも": {
            "en": "Try your best to not use ほかにも in negative sentences like this one. ほか(に)は has a strong tendency to appear in negative sentences instead.",
            "es": ""
          },
          "ほかの": {
            "en": "Could you try a different particle that highlights 他 as being the target of what comes next in any particular sentence?",
            "es": "",
            "fr": ""
          },
          "なんでも": {
            "en": "なんでも means 'anything' or 'everything'. Could you try a grammar point with a nuance of 'Anything else'?",
            "es": "",
            "fr": ""
          },
          "いがい": {
            "en": "いがい has the nuance of 'except'. Could you try a grammar point with a weaker nuance of 'another' or 'any other'?",
            "es": "",
            "fr": ""
          }
        },
        "translation": "No, I don't need <strong>anything else</strong>.",
        "nuance_translation": "A structure which may either indicate or negate the presence of something <strong>other than</strong> (A).",
