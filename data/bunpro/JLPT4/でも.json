    {
      "id": "1146",
      "type": "related_content",
      "attributes": {
        "id": 1146,
        "relationship_type": "related",
        "body": "もしも～なら and もしも～でも emphasize a hypothetical situation, similar to 'supposing that (A)' or 'even if (A)' in English. Separately, でも can attach to question words to mean 'any~', e.g. 誰でも 'anyone' and なんでも 'anything', or follow regular nouns to suggest a casual option, as in お茶でも飲みませんか？ ('Want some tea or something?').",
        "first_relatable": {
          "id": 493,
          "slug": "もしも～なら・もしも～でも",
