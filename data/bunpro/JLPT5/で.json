    {
      "id": "1305",
      "type": "related_content",
      "attributes": {
        "id": 1305,
        "relationship_type": "related",
        "body": "Both で and において・における indicate the location where an action takes place, but differ significantly in formality. で is common in daily speech and informal writing, whereas において・における appear mainly in formal contexts or written language. Additionally, において・における can express meanings like 'in terms of' or 'with respect to.'",
        "first_relatable": {
