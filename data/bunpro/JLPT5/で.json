    {
      "id": "464",
      "type": "related_content",
      "attributes": {
        "id": 464,
        "relationship_type": "synonym",
        "body": "The particle で has two main uses: the first is indicating the location where an action takes place (e.g., 家で遊ぶ = 'play at home'). The second is marking the means or instrument used to perform an action (e.g., ボールで遊ぶ = 'play with a ball'). These differences can usually be inferred from context, so it's recommended to not stress this too much.",
        "first_relatable": {
          "id": 36,
          "slug": "で-by",
          "title": "で",
          "meaning": "With, By (using)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 25,
          "slug": "で",
          "title": "で",
          "meaning": "At, In",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "108",
      "type": "related_content",
      "attributes": {
        "id": 108,
        "relationship_type": "synonym",
        "body": "で and にて both indicate the location or means of an action, differing mainly in formality. で is used commonly in everyday conversation and informal writing, whereas にて appears primarily in formal contexts such as business, academic documents, or speeches. Historically, で evolved from にて, with their sounds merging over time.",
        "first_relatable": {
          "id": 25,
          "slug": "で",
          "title": "で",
          "meaning": "At, In",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
