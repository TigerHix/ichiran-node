    {
      "id": "205",
      "type": "related_content",
      "attributes": {
        "id": 205,
        "relationship_type": "related",
        "body": "The particle まで means 'until' when used with a verb that can describe a progressive or ongoing action, e.g. 8時までテレビを見る 'watch TV until eight o'clock'. In contrast, までに means 'by', 'before', or 'no later than', and is used with verbs that describe actions with a set completion point, e.g. 8時までに終わる 'to finish by/before eight o'clock.'",
        "first_relatable": {
          "id": 360,
          "slug": "v-まで",
          "title": "Verb + まで",
          "meaning": "Until (something) happens",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
