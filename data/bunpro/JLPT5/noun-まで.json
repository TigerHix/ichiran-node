    {
      "id": "203",
      "type": "related_content",
      "attributes": {
        "id": 203,
        "relationship_type": "related",
        "body": "The particle まで has the core meaning of 'as far as.' It's commonly used with time expressions to mean 'until' (e.g. 月曜まで休む = 'rest until Monday') and with places to mean 'up to' or 'to (a location)' (e.g. 駅まで送る = 'see [someone] off to the station'). When used with verbs or non-location nouns, it can mean 'even' or 'as much as' (e.g. 骨まで食べる = 'eat even the bones').",
        "first_relatable": {
          "id": 58,
          "slug": "noun-まで",
          "title": "Noun + まで",
          "meaning": "Until, Till,  To (but no further than)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
