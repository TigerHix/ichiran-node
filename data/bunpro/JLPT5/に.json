    {
      "id": "93",
      "type": "related_content",
      "attributes": {
        "id": 93,
        "relationship_type": "related",
        "body": "に is a versatile particle marking direction, destination, targets of actions, or places of existence, often translating as 'to,' 'in,' or similar English prepositions. で specifically marks the location where an action occurs. The main distinction is whether the verb describes an action or existence; for example, 東京に住む ('live in Tokyo') emphasizes existence, while 東京で勉強する ('study in Tokyo') highlights where the action happens.",
        "first_relatable": {
          "id": 32,
          "slug": "に",
          "title": "に",
          "meaning": "In, At, To, For, On",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 25,
          "slug": "で",
          "title": "で",
          "meaning": "At, In",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
