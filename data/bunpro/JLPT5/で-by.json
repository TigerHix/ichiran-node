        }
      }
    },
    {
      "id": "1502",
      "type": "related_content",
      "attributes": {
        "id": 1502,
        "relationship_type": "related",
        "body": "を以て can be though of as a highly formal/written-style version of the basic particle で when used to mean 'with'/'by means of', e.g. 鉛筆で書く 'write with a pencil' vs. 死を以て償う 'to atone (e.g. for a sin) with one's death' or 'at this point in time', e.g. これ（で・を以て）閉会します ('With this, we will end the meeting.'). Note that を以て would not typically be used with the meaning of で indicating 'place of an action', e.g. 大手企業で働く 'to work at a major corporation'.",
        "first_relatable": {
          "id": 739,
          "slug": "を以て",
          "title": "を以て",
          "meaning": "By means of, With, By, Via, In view of",
          "level": "JLPT1",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 36,
          "slug": "で-by",
          "title": "で",
          "meaning": "With, By (using)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "464",
      "type": "related_content",
      "attributes": {
        "id": 464,
        "relationship_type": "synonym",
        "body": "The particle で has two main uses: the first is indicating the location where an action takes place (e.g., 家で遊ぶ = 'play at home'). The second is marking the means or instrument used to perform an action (e.g., ボールで遊ぶ = 'play with a ball'). These differences can usually be inferred from context, so it's recommended to not stress this too much.",
        "first_relatable": {
          "id": 36,
          "slug": "で-by",
          "title": "で",
          "meaning": "With, By (using)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 25,
          "slug": "で",
          "title": "で",
          "meaning": "At, In",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "504",
      "type": "related_content",
      "attributes": {
        "id": 504,
        "relationship_type": "related",
        "body": "The particle で follows a noun to describe the means or method of an action (e.g., ペンで書く = 'to write with a pen'). A verb in the て form can express a similar nuance (e.g., ペンを使って書く = 'to write using a pen,' 歩いて行く = 'to go by walking'). The meaning is the same, but the form differs depending on whether the 'method' is expressed with a noun or a verb.",
        "first_relatable": {
          "id": 36,
          "slug": "で-by",
          "title": "で",
          "meaning": "With, By (using)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
