    {
      "id": "1288",
      "type": "related_content",
      "attributes": {
        "id": 1288,
        "relationship_type": "antonym",
        "body": "まだ and もう are both adverbs that indicate the timing of an action or state (or lack thereof). まだ implies that something is still in a certain state or that an action has not yet occurred, similar to 'still' or ' not yet' in English. In contrast, もう indicates that a change has occurred, similar to 'already' (in affirmatives) or 'no longer' (in negatives).",
        "first_relatable": {
          "id": 72,
          "slug": "まだ",
          "title": "まだ",
          "meaning": "Still",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 42,
          "slug": "もう",
          "title": "もう",
          "meaning": "Already, Anymore",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "370",
      "type": "related_content",
      "attributes": {
        "id": 370,
        "relationship_type": "related",
        "body": "まだ suggests that something remains in a state, or that an action has not yet occurred, similar to the English 'still' or 'not yet.' When used with a verb in the ていません form, it expresses the continued non-occurrence of an action. For example, まだ食べていません means 'I haven't eaten yet' or 'I still haven't eaten.'",
        "first_relatable": {
          "id": 72,
          "slug": "まだ",
          "title": "まだ",
          "meaning": "Still",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 83,
          "slug": "まだ-ていません",
          "title": "まだ～ていません",
          "meaning": "Still haven't done (something)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
