      "id": "197",
      "type": "related_content",
      "attributes": {
        "id": 197,
        "relationship_type": "related",
        "body": "どこ is a question word used to ask about locations, similar to 'where' in English. In contrast, ここ refers specifically to a place close to the speaker, either physically or figuratively, equivalent to 'here.' For example, トイレはどこですか？ ('Where is the bathroom?') could be answered by ここです ('It's here'—near the speaker or indicated location).",
        "first_relatable": {
          "id": 56,
          "slug": "どこ",
          "title": "どこ",
          "meaning": "Where",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 14,
          "slug": "ここ",
          "title": "ここ",
          "meaning": "Here, This place",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
