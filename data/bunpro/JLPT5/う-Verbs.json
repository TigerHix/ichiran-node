    {
      "id": "49",
      "type": "related_content",
      "attributes": {
        "id": 49,
        "relationship_type": "related",
        "body": "The dictionary form is the base form of the verb, used for habitual or future actions. The negative form expresses that an action doesn't happen or a state doesn't exist. For る-Verbs, the negative is formed by changing る to ない (e.g., 食べる → 食べない). う-Verbs have different conjugation patterns. Be careful: not all verbs ending in る are る-Verbs—for example, 帰る ('to return') is actually an う-Verb.",
        "first_relatable": {
          "id": 51,
          "slug": "るverb-ない",
          "title": "る-Verb (Negative)",
          "meaning": "Will/Does/Do (not)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
