    {
      "id": "1288",
      "type": "related_content",
      "attributes": {
        "id": 1288,
        "relationship_type": "antonym",
        "body": "まだ and もう are both adverbs that indicate the timing of an action or state (or lack thereof). まだ implies that something is still in a certain state or that an action has not yet occurred, similar to 'still' or ' not yet' in English. In contrast, もう indicates that a change has occurred, similar to 'already' (in affirmatives) or 'no longer' (in negatives).",
        "first_relatable": {
          "id": 72,
          "slug": "まだ",
          "title": "まだ",
          "meaning": "Still",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
