    {
      "id": "1524",
      "type": "related_content",
      "attributes": {
        "id": 1524,
        "relationship_type": "related",
        "body": "すら and も are fundamentally similar in that both can serve to add emphasis. In cases like 子どもですらできる 'even a child can do it' 子どもでもできる (same meaning) they are essentially interchangeable except that すら is more formal and more emphatic. In examples where も is simply serving to add additional information, e.g. 田中さんも来た ('Mr. Tanaka also came.'), も could not be replaced with すら (unless there is some reason to believe that Tanaka coming would be an extremely rare or unexpected happening).",
        "first_relatable": {
          "id": 787,
          "slug": "すら",
          "title": "すら",
          "meaning": "Even",
          "level": "JLPT1",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
