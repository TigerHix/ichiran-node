        }
      }
    },
    {
      "id": "1477",
      "type": "related_content",
      "attributes": {
        "id": 1477,
        "relationship_type": "related",
        "body": "でもある and も can both express 'also' (the も of でもある is the same as the particle も), but there is a key difference to note. AもB means '(A) is also (B)', while Aでもある means 'it is also (A)'. For example, compare 田中さんは学生です。鈴木さんも学生です ('Tanaka is a student. Suzuki is also a student') vs. 田中さんは学生です。日本人でもあります ('Tanaka is a student. He is also Japanese').",
        "first_relatable": {
          "id": 666,
          "slug": "でもある",
          "title": "でもある",
          "meaning": "Be also, It also is",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
