    {
      "id": "1465",
      "type": "related_content",
      "attributes": {
        "id": 1465,
        "relationship_type": "related",
        "body": "Both 連用形 and the て form connect sequential actions, but 連用形 sounds more formal and is often used in writing. For example, 起きて becomes 起き, e.g. ８時に起きて、朝ご飯を食べました 'I got up at 8 o'clock, then ate breakfast.' → ８時に起き、朝ご飯を食べました. (Same meaning, different register.)",
        "first_relatable": {
          "id": 470,
          "slug": "連用形",
          "title": "連用形",
          "meaning": "Formal Conjunctive",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
