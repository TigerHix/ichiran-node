    {
      "id": "588",
      "type": "related_content",
      "attributes": {
        "id": 588,
        "relationship_type": "related",
        "body": "The Verb + て form connects verbs or parts of a sentence. When combined with いた, it describes a past state. For example, 食べていた means 'I was eating,' and 死んでいた means 'it was dead.' Whether ていた conveys an action ('was -ing') or a state depends on the verb. In casual speech, ていた is often shortened to てた.",
        "first_relatable": {
          "id": 136,
          "slug": "ていた",
          "title": "ていた ",
          "meaning": "Was doing ~",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 416,
          "slug": "verb-て",
          "title": "Verb + て",
          "meaning": "And, Then (Linking events)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "627",
      "type": "related_content",
      "attributes": {
        "id": 627,
        "relationship_type": "related",
        "body": "The う-Verb (Past) expresses a completed action or one that took place in the past, similar to '-ed' in English. The ていた form conveys an ongoing action or state in the past, similar to 'was -ing' in English. In other words, ていた indicates an action that was continuous or repeated, while the regular past form describes a single, completed action.",
        "first_relatable": {
          "id": 136,
          "slug": "ていた",
          "title": "ていた ",
