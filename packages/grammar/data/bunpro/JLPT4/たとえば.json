    {
      "id": "620",
      "type": "related_content",
      "attributes": {
        "id": 620,
        "relationship_type": "related",
        "body": "たとえば and とか～とか both introduce examples, but differ in usage. たとえば comes at the start of a sentence or clause, like 'for example'. In contrast, とか～とか is used to list multiple items and follows each noun. Because they differ in function, they can be used together in the same sentence, e.g. たとえば本とか雑誌とか ('For example, things like books, magazines, and so forth.').",
        "first_relatable": {
          "id": 376,
          "slug": "たとえば",
          "title": "たとえば",
          "meaning": "For example",
          "level": "JLPT4",
