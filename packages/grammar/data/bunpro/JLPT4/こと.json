    {
      "id": "692",
      "type": "related_content",
      "attributes": {
        "id": 692,
        "relationship_type": "related",
        "body": "These related expressions both use the noun こと, or 事 in kanji. On its own, こと turns a verb or adjective into a noun phrase, e.g. 食べる 'to eat' becomes 食べること 'the act of eating'. When combined with the explanatory/emphatic なの, it conveys meaning or definition, e.g. 'It means that (A)' or '(A) is how it is.'",
        "first_relatable": {
          "id": 630,
          "slug": "ことなの",
          "title": "ことなの",
          "meaning": "(A) is (Description of A), (A) means that (Description of A)",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 98,
          "slug": "こと",
          "title": "こと",
          "meaning": "Converting a verb into a noun",
