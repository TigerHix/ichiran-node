    {
      "id": "702",
      "type": "related_content",
      "attributes": {
        "id": 702,
        "relationship_type": "related",
        "body": "こと attaches to the dictionary form of verbs to turn them into nouns, e.g. 行くこと '(the act of) going'. ということ has a similar function, but adds the quoting phrase という, so it's often used to clarify information or reported speech, e.g. 日本に行くということ 'the fact that (he) is going to Japan'.",
        "first_relatable": {
          "id": 98,
