    {
      "id": "145",
      "type": "related_content",
      "attributes": {
        "id": 145,
        "relationship_type": "related",
        "body": "Both こと and の turn verbs or adjectives into noun phrases. こと is used for intangible or conceptual ideas, while の is used for more tangible or physical concepts. For example, 走るのが好きです and 走ることが好きです both mean 'I like running,' with の feeling more physical and こと more conceptual. However, they aren't interchangeable in set phrases like ことができる or ことがある.",
        "first_relatable": {
          "id": 98,
          "slug": "こと",
          "title": "こと",
          "meaning": "Converting a verb into a noun",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 16,
          "slug": "のは",
          "title": "の",
          "meaning": "Verb nominalizer, The one who..., That which...",
          "level": "JLPT5",
