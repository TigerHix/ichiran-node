    {
      "id": "1385",
      "type": "related_content",
      "attributes": {
        "id": 1385,
        "relationship_type": "related",
        "body": "なおす can be attached to the stem of other verbs to express the idea of 're-doing' or doing something over. つづける can be attached to verb stems in the same way, but expresses the meaning of 'continuing' to do something. For example, やりなおす means 'to do over', while やりつづける means 'to keep doing'.",
        "first_relatable": {
          "id": 393,
          "slug": "なおす",
          "title": "なおす",
          "meaning": "To do over, To redo",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 180,
          "slug": "つづける",
          "title": "つづける",
          "meaning": "To continue",
          "level": "JLPT4",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        }
      }
    },
    {
      "id": "779",
      "type": "related_content",
      "attributes": {
        "id": 779,
        "relationship_type": "related",
        "body": "Both つづける and てくる can show the progression of an action over time. つづける attaches to the verb stem and focuses on the continuation of the action itself. てくる uses the て-form and emphasizes that the action started in the past and has continued up to the present.",
        "first_relatable": {
          "id": 180,
          "slug": "つづける",
          "title": "つづける",
          "meaning": "To continue",
          "level": "JLPT4",
