    {
      "id": "1410",
      "type": "related_content",
      "attributes": {
        "id": 1410,
        "relationship_type": "synonym",
        "body": "The imperative or command form (命令形) gives blunt commands, e.g. 止まれ ('Stop!'), often sounding forceful. Verb[て] form is softer and used for casual requests, e.g. 見て 'Look!'. Adding よ or ね softens it further, e.g. 見てね ('Take a look, okay?'), which is commonly done in friendly, everyday speech.",
        "first_relatable": {
          "id": 1032,
