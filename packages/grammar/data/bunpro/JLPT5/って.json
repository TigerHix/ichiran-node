        "id": 961,
        "relationship_type": "related",
        "body": "って (a contracted form of と) is a casual quoting particle used to mark direct or indirect speech, thoughts, feelings, or to introduce a topic. んだって, which combines って with the explanatory ん・の, is used to express 'I heard' or 'He/she/they said.' While って can follow any word, んだって requires な before な-Adjectives or nouns.",
        "first_relatable": {
          "id": 246,
          "slug": "んだって",
          "title": "んだって",
          "meaning": "I heard that, He or She said that",
          "level": "JLPT3",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
