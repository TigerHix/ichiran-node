    {
      "id": "193",
      "type": "related_content",
      "attributes": {
        "id": 193,
        "relationship_type": "related",
        "body": "と and って are quoting particles marking direct or indirect speech, thoughts, or feelings. For example, 行くと言っていた and 行くって言っていた both mean '[They] were saying [they] will go.' The difference is that って is used mainly in casual conversation, while と is used in speech or writing. って can also casually introduce a topic, like 日本っていいよね ('Japan is great, isn't it?'), which と cannot.",
        "first_relatable": {
          "id": 356,
          "slug": "と",
          "title": "と",
          "meaning": "Quotation",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
