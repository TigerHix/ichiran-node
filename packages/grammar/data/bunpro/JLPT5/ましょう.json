        }
      }
    },
    {
      "id": "368",
      "type": "related_content",
      "attributes": {
        "id": 368,
        "relationship_type": "related",
        "body": "ましょう and Verb[よう] are both volitional forms that mean 'Let's (do something).' The difference is tone: ましょう is polite, while Verb[よう] is casual. For example, 行きましょう (polite) and 行こう (casual) both mean 'Let's go.' The casual Verb[よう] form is also used in other grammar patterns to express intent, such as 行こうと思う ('I think I'll go' / 'I'm planning to go').",
        "first_relatable": {
          "id": 70,
          "slug": "ましょう",
          "title": "ましょう",
          "meaning": "Let's, Shall we (Polite volitional)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
