        }
      }
    },
    {
      "id": "369",
      "type": "related_content",
      "attributes": {
        "id": 369,
        "relationship_type": "related",
        "body": "ましょう and ませんか are both polite expressions based on the ます form that can be used to make suggestions or invitations. ましょう is more assertive and usually implies the speaker and listener will do something together (e.g., 食べましょう = 'Let's eat'). In contrast, ませんか is more of an invitation directed at the listener (e.g., 食べませんか = 'Won't you eat [some]?').",
        "first_relatable": {
          "id": 70,
          "slug": "ましょう",
          "title": "ましょう",
          "meaning": "Let's, Shall we (Polite volitional)",
          "level": "JLPT5",
          "type_pascal": "GrammarPoint",
          "type_snake": "grammar_point"
        },
        "second_relatable": {
          "id": 82,
          "slug": "ませんか",
          "title": "ませんか",
          "meaning": "Won't you, Would you not, Why don't we",
          "level": "JLPT5",
