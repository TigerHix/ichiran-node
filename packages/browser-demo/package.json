{
  "name": "@ichiran/browser-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:benchmark-corpus && bun run --cwd ../core build && bun run --cwd ../presentation build && vite build && bun scripts/audit-build.ts",
    "build:qualification-browser": "vite build --mode qualification && bun scripts/audit-build.ts --qualification",
    "build:qualification-typescript-oracle": "bun run build:benchmark-corpus && bun run --cwd ../core build && vite build --mode typescript-oracle && bun scripts/audit-build.ts --typescript-oracle",
    "build:benchmark-corpus": "bun scripts/build-benchmark-corpus.ts",
    "stage:analyzer": "bun scripts/stage-analyzer.ts",
    "audit:build": "bun scripts/audit-build.ts",
    "audit:release": "bun scripts/audit-build.ts --require-rust --require-analyzer",
    "qualify": "bun scripts/qualify.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "bun scripts/run-e2e.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@ichiran/core": "workspace:*",
    "@ichiran/presentation": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "1.62.1",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "sideEffects": false
}
