{
  "name": "@ichiran/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:migration": "tsc --noEmit -p tsconfig.migration.json",
    "test": "bun test tests/",
    "test:source": "bun scripts/test-source.ts"
  },
  "dependencies": {
    "@ichiran/core": "workspace:*",
    "csv-parse": "^6.1.0",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@ichiran/reference-postgres": "0.0.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "postgres": "^3.4.7"
  },
  "sideEffects": false
}
