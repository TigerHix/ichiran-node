{
  "name": "@ichiran/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./qualification": {
      "types": "./dist/qualification.d.ts",
      "default": "./dist/qualification.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    },
    "./qualification/runtime": {
      "types": "./dist/runtime-qualification.d.ts",
      "default": "./dist/runtime-qualification.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../rust-kernel/scripts/build-wasm.sh && bun run build:typescript",
    "build:typescript": "rm -rf dist && tsc -p tsconfig.json && bun scripts/copy-rust-kernel.ts",
    "build:compiler": "bun run build:typescript",
    "build:watch": "tsc -p tsconfig.json --watch",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/"
  },
  "sideEffects": false
}
